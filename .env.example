# Persistence and runtime
YGGDRASIL_DATABASE_URL=sqlite+pysqlite:///./.yggdrasil/local-dev.db
YGGDRASIL_AUTO_CREATE_SCHEMA=1
YGGDRASIL_REDIS_URL=redis://127.0.0.1:6379/0
YGGDRASIL_NATS_URL=nats://127.0.0.1:4222
YGGDRASIL_NATS_STREAM=YGGDRASIL
YGGDRASIL_NATS_SUBJECT_PREFIX=yggdrasil.events
YGGDRASIL_STATE_ROOT=.yggdrasil
YGGDRASIL_CORE_API_BASE_URL=http://127.0.0.1:8000
YGGDRASIL_GIT_REPO_PATH=.
YGGDRASIL_MCP_PROJECT_WORKSPACE=.

# Optional runtime defaults
YGGDRASIL_COORDINATION_BACKEND=auto
YGGDRASIL_RUNTIME_AUDIT_LEVEL=default
YGGDRASIL_ALLOW_PAID_MODELS=0

# Optional local port overrides
YGGDRASIL_MINIO_API_PORT=9000
YGGDRASIL_MINIO_CONSOLE_PORT=9001

# Optional observability
YGGDRASIL_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3100

# Configure at least one model provider
# `corepack pnpm eval:m8:live` 默认请求 `longcat/LongCat-2.0-Preview`，并保留 `longcat/LongCat-Flash-Lite` 作为对照项。
# 如需真实供应商调用，请至少设置 `YGGDRASIL_LLM_API_KEY_LONGCAT` 或 `LONGCAT_API_KEY` 之一；
# 若改用其他 provider，需要同时修改 live suite 中的 requestedProvider/requestedModel。
YGGDRASIL_LLM_API_KEY_LONGCAT=
YGGDRASIL_LLM_API_KEY_OPENROUTER=
YGGDRASIL_LLM_API_KEY_DEEPSEEK=
YGGDRASIL_LLM_API_KEY_VECTORENGINE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LONGCAT_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
VECTORENGINE_API_KEY=

# Optional academic retrieval providers (for graduate-researcher high-standard runs)
OPENALEX_API_KEY=
PMC_API_KEY=
PMC_CONTACT_EMAIL=