{
  "include": [
    "packages/python-sdk/src",
    "services/*/src",
    "modules/*/src",
    "adapters/*/src",
    "tests"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "tmp",
    "dist",
    "build"
  ],
  "extraPaths": [
    "packages/python-sdk/src",
    "services/agent-runtime/src",
    "services/core-api/src",
    "services/module-host/src",
    "services/worker/src",
    "modules/context-pruning/src",
    "modules/memory-organizer/src",
    "modules/multimodal-memory/src",
    "modules/pause-resume/src",
    "modules/relation-discovery/src",
    "modules/shared-memory/src",
    "modules/subagent-pr/src",
    "modules/text-memory/src",
    "modules/training-lab/src",
    "adapters/media-providers/src",
    "adapters/model-providers/src"
  ],
  "typeCheckingMode": "basic",
  "pythonVersion": "3.12",
  "pythonPlatform": "All",
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": false,
  "reportUnusedImport": "warning",
  "reportUnusedClass": "none",
  "reportUnusedFunction": "none",
  "reportUnusedVariable": "warning",
  "reportDuplicateImport": "warning",
  "reportOptionalSubscript": "none",
  "reportOptionalMemberAccess": "none",
  "reportOptionalCall": "none",
  "reportOptionalIterable": "none",
  "reportOptionalContextManager": "none",
  "reportAttributeAccessIssue": "none",
  "reportIndexIssue": "none",
  "reportOperatorIssue": "none",
  "reportArgumentType": "none",
  "reportUntypedFunctionDecorator": "none",
  "reportUntypedClassDecorator": "none",
  "reportUntypedBaseClass": "none",
  "reportGeneralTypeIssues": "none",
  "reportMissingTypeArgument": "none",
  "reportUnknownArgumentType": "none",
  "reportUnknownLambdaType": "none",
  "reportUnknownVariableType": "none",
  "reportUnknownMemberType": "none",
  "reportUnknownParameterType": "none",
  "reportUnnecessaryIsInstance": "warning",
  "reportUnnecessaryCast": "warning",
  "reportCallIssue": "none",
  "reportUnsupportedDunderAll": "warning"
}
